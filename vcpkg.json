{
  "dependencies": [
    "assimp",
    {
      "name": "directx-dxc",
      "platform": "(windows & !arm32 & !uwp & !xbox) | (linux & x64)"
    },
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": [
        "avcodec",
        "avdevice",
        "avformat",
        "swresample",
        "swscale"
      ],
      "platform": "!mingw"
    },
    "freetype",
    "glm",
    "glslang",
    "gtest",
    {
      "name": "openal-soft",
      "platform": "!wasm32"
    },
    "sdl3",
    "shaderc",
    "spirv-cross",
    "spirv-headers",
    "spirv-reflect",
    "stb",
    "vulkan-memory-allocator",
    {
      "name": "winpixevent",
      "platform": "windows & (x64 | arm64) & !staticcrt & !xbox"
    },
    "yaml-cpp"
  ]
}
