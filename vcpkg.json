{
  "dependencies": [
    "assimp",
    {
      "name": "directx-dxc",
      "platform": "(windows & !arm32 & !uwp & !xbox) | (!windows & x64)"
    },
    "freetype",
    "glm",
    "glslang",
    "openal-soft",
    "sdl3",
    "shaderc",
    "spirv-cross",
    "spirv-headers",
    "spirv-reflect",
    "stb",
    {
      "name": "winpixevent",
      "platform": "windows & (x64 | arm64) & !staticcrt & !xbox"
    },
    "yaml-cpp",
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": [
        "avcodec",
        "avformat",
        "swresample",
        "swscale",
        "avdevice"
      ]
    }

  ],
  "overrides": [
    {
      "name": "ffmpeg",
      "version": "7.1.2"
    }
  ]
}
