{
  "version": 6,

  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "cacheVariables": {

        "NX_PLATFORM_OPENGL": "1",
        "NX_PLATFORM_VULKAN": "1",
        "NX_PLATFORM_OPENAL": "1",

        "NX_BUILD_DEMO": "1",
        "NX_BUILD_EDITOR": "1",
        "BUILD_TESTING": "1"
      }
    },
    {
      "name": "windows-msvc-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe",
        "NX_PLATFORM_D3D12": "1",
        "NX_BUILD_TYPE": "SHARED",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-clang-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl.exe",
        "CMAKE_CXX_COMPILER": "clang-cl.exe",
        "NX_PLATFORM_D3D12": "1",
        "NX_BUILD_TYPE": "SHARED",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-mingw-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "x86_64-w64-mingw32-gcc.exe",
        "CMAKE_CXX_COMPILER": "x86_64-w64-mingw32-g++.exe",
        "NX_BUILD_TYPE": "STATIC",
        "VCPKG_TARGET_TRIPLET": "x64-mingw-dynamic"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-gcc-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "NX_BUILD_TYPE": "STATIC",
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-clang-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "NX_BUILD_TYPE": "STATIC",
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "windows-x64-msvc-debug",
      "displayName": "Windows x64 MSVC Debug",
      "inherits": "windows-msvc-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },

    {
      "name": "windows-x64-msvc-release",
      "displayName": "Windows x64 MSVC  Release",
      "inherits": "windows-msvc-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },

    {
      "name": "windows-x64-msvc-relwithdebinfo",
      "displayName": "Windows x64 MSVC RelWithDebInfo",
      "inherits": "windows-msvc-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },

    {
      "name": "windows-x64-msvc-minsizerel",
      "displayName": "Windows x64 MSVC MinSizeRel",
      "inherits": "windows-msvc-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "MinSizeRel" }
    },

    {
      "name": "windows-x64-clang-debug",
      "displayName": "Windows x64 Clang Debug",
      "inherits": "windows-clang-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },

    {
      "name": "windows-x64-clang-release",
      "displayName": "Windows x64 Clang  Release",
      "inherits": "windows-clang-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },

    {
      "name": "windows-x64-clang-relwithdebinfo",
      "displayName": "Windows x64 Clang RelWithDebInfo",
      "inherits": "windows-clang-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },

    {
      "name": "windows-x64-clang-minsizerel",
      "displayName": "Windows x64 Clang MinSizeRel",
      "inherits": "windows-clang-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "MinSizeRel" }
    },
    {
      "name": "windows-x64-mingw-debug",
      "displayName": "Windows x64 MinGW Debug",
      "inherits": "windows-mingw-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-x64-mingw-release",
      "displayName": "Windows x64 MinGW Release",
      "inherits": "windows-mingw-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-x64-mingw-relwithdebinfo",
      "displayName": "Windows x64 MinGW RelWithDebInfo",
      "inherits": "windows-mingw-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "windows-x64-mingw-minsizerel",
      "displayName": "Windows x64 MinGW MinSizeRel",
      "inherits": "windows-mingw-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel"
      }
    },
    {
      "name": "linux-x64-gcc-debug",
      "displayName": "Linux x64 GCC Debug",
      "inherits": "linux-gcc-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },

    {
      "name": "linux-x64-gcc-release",
      "displayName": "Linux x64 GCC Release",
      "inherits": "linux-gcc-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },

    {
      "name": "linux-x64-gcc-relwithdebinfo",
      "displayName": "Linux x64 GCC RelWithDebInfo",
      "inherits": "linux-gcc-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },

    {
      "name": "linux-x64-gcc-minsizerel",
      "displayName": "Linux x64 GCC MinSizeRel",
      "inherits": "linux-gcc-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "MinSizeRel" }
    },

    {
      "name": "linux-x64-clang-debug",
      "displayName": "Linux x64 Clang Debug",
      "inherits": "linux-clang-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },

    {
      "name": "linux-x64-clang-release",
      "displayName": "Linux x64 Clang Release",
      "inherits": "linux-clang-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },

    {
      "name": "linux-x64-clang-relwithdebinfo",
      "displayName": "Linux x64 Clang RelWithDebInfo",
      "inherits": "linux-clang-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },

    {
      "name": "linux-x64-clang-minsizerel",
      "displayName": "Linux x64 Clang MinSizeRel",
      "inherits": "linux-clang-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "MinSizeRel" }
    }
  ]
}